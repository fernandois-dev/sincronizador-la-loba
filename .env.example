# Copia las líneas que necesites a .env (que NO se sube a git) y completa los valores.

# ── Asistente IA ────────────────────────────────────────────
# Proveedores: nvidia | groq | cerebras | gemini | openrouter | ollama
IA_PROVEEDOR=nvidia
IA_API_KEY=
IA_MODELO=deepseek-ai/deepseek-v3.2
# Modelo de embeddings para la búsqueda por significado (RAG)
IA_MODELO_EMBEDDINGS=nvidia/nemotron-3-embed-1b
# Opcional: embeddings en otro proveedor que el chat (ej. chat en groq, embeddings en nvidia).
# Si se omiten, se usan IA_PROVEEDOR e IA_API_KEY.
# IA_EMB_PROVEEDOR=nvidia
# IA_EMB_API_KEY=
# Gemini (gratis, clave en aistudio.google.com): IA_EMB_PROVEEDOR=gemini,
# IA_MODELO_EMBEDDINGS=gemini-embedding-2 e IA_EMB_DIMENSIONES=768 (vectores más cortos).
# IA_EMB_DIMENSIONES=
# Plan pagado de Gemini: IA_EMB_POR_MINUTO=0 quita la pausa entre lotes (plan gratis: 90 por minuto)
# Opcional: respaldo si el principal falla o llega a su límite. Puede ser otro proveedor
# (con su IA_RESPALDO_API_KEY) u otros modelos del mismo, separados por coma (usa la misma key).
# En Groq cada modelo tiene su propio límite por minuto, así que esto suma capacidad gratis:
# IA_RESPALDO_PROVEEDOR=groq
# IA_RESPALDO_MODELO=openai/gpt-oss-20b,qwen/qwen3.8-27b
# IA_RESPALDO_API_KEY=          (solo si el respaldo es de otro proveedor)
# Modelo para redactar descripciones de Mercado Libre (si falta, usa IA_MODELO)
IA_MODELO_DESCRIPCION=google/gemma-4-31b-it
# Opcionales
# IA_MAX_PASOS=6
# IA_TEMPERATURA=0.2
# IA_BASE_URL=          # solo si el proveedor no está en la lista

# Mercado Libre (developers.mercadolibre.cl)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://example.com/
ML_USAR_PKCE=0
# carpeta de Drive con ml_tokens.json, para compartir la conexión entre computadores
ML_TOKENS_DRIVE_FOLDER=
